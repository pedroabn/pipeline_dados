# .env.example
# Copie para .env e preencha com valores reais
# NÃO COMITE O ARQUIVO .env NO GIT!

# ============================================
# CONFIGURAÇÕES GERAIS
# ============================================
ENVIRONMENT=dev                          # dev, staging, prod
PROJECT_NAME=marketing-data-pipeline
LOG_LEVEL=INFO

# ============================================
# META ADS (Facebook Ads)
# ============================================
META_ADS_ACCESS_TOKEN=your_token_here
META_ADS_ACCOUNT_ID=act_123456789
META_ADS_API_VERSION=v18.0

# ============================================
# GOOGLE ANALYTICS 4
# ============================================
GA4_PROPERTY_ID=123456789
GA4_CREDENTIALS_PATH=/path/to/service-account.json
# OU usar credenciais direto (base64 do JSON)
GA4_CREDENTIALS_JSON=

# ============================================
# GOOGLE CLOUD PLATFORM
# ============================================
GCP_PROJECT_ID=my-project-id
GCP_REGION=us-central1
GCP_CREDENTIALS_PATH=/path/to/service-account.json

# BigQuery
BQ_DATASET_BRONZE=marketing_bronze
BQ_DATASET_SILVER=marketing_silver
BQ_DATASET_GOLD=marketing_gold

# Cloud Storage
GCS_BUCKET_RAW=my-bucket-raw
GCS_BUCKET_PROCESSED=my-bucket-processed
GCS_RETENTION_DAYS=90

# ============================================
# AIRFLOW
# ============================================
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__CORE__SQL_ALCHEMY_CONN=postgresql+psycopg2://airflow:airflow@postgres:5432/airflow
AIRFLOW__CORE__FERNET_KEY=your_fernet_key_here
AIRFLOW__WEBSERVER__SECRET_KEY=your_secret_key_here

# ============================================
# DBT
# ============================================
DBT_PROFILES_DIR=./dbt
DBT_TARGET=dev                           # dev, prod

# ============================================
# ALERTAS E NOTIFICAÇÕES
# ============================================
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
SLACK_CHANNEL=#data-alerts

# Email (opcional)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password

# ============================================
# OUTROS
# ============================================
TIMEZONE=America/Sao_Paulo
RETRY_MAX_ATTEMPTS=3
RETRY_DELAY_SECONDS=60